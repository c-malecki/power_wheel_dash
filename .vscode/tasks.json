{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "ESP-IDF: Dev Build, Flash & Monitor",
            "type": "shell",
            "command": "bash -ic 'espidf && idf.py -DDEVELOPMENT=1 build flash monitor'",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}